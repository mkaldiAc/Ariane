{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIANE Observation attributaire",
  "type": "object",
  "required": ["programme_id", "capture_id", "source_id", "observation_id", "object_id", "attribute_id", "value_raw", "identification_mode", "confidence"],
  "properties": {
    "programme_id": {"type": "string"},
    "capture_id": {"type": "string"},
    "structure_version": {"type": ["string", "null"]},
    "source_id": {"type": "string"},
    "observation_id": {"type": "string"},
    "object_id": {"type": "string"},
    "attribute_id": {"type": "string"},
    "structural_binding_status": {
      "enum": ["RATTACHE_STRUCTURE_VALIDEE", "EN_ATTENTE_RATTACHEMENT_STRUCTUREL", null],
      "description": "EN_ATTENTE_RATTACHEMENT_STRUCTUREL est obligatoire selon les règles lorsqu'une observation porte sur un CANDIDAT_STRUCTURE."
    },
    "value_raw": {},
    "value_normalized": {},
    "unit_raw": {"type": ["string", "null"]},
    "unit_normalized": {"type": ["string", "null"]},
    "page_or_plan": {"type": ["string", "null"]},
    "source_anchor": {"type": ["string", "null"]},
    "identification_mode": {"enum": ["EXPLICITE", "DEDUIT", "PROXY", "ENRICHI"]},
    "derivation_rule": {"type": ["string", "null"]},
    "confidence": {
      "type": "object",
      "required": ["score", "evidence_score", "object_binding_score", "semantic_match_score", "transformation_score"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "evidence_score": {"type": "number", "minimum": 0, "maximum": 30},
        "object_binding_score": {"type": "number", "minimum": 0, "maximum": 30},
        "semantic_match_score": {"type": "number", "minimum": 0, "maximum": 25},
        "transformation_score": {"type": "number", "minimum": 0, "maximum": 15}
      }
    }
  },
  "additionalProperties": true
}
