{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ariane.anomalie.schema.json",
  "type": "object",
  "required": ["programme_id", "capture_id", "anomaly_id", "anomaly_type", "description"],
  "properties": {
    "programme_id": {"type": "string"},
    "capture_id": {"type": "string"},
    "source_id": {"type": ["string", "null"]},
    "anomaly_id": {"type": "string"},
    "anomaly_type": {"enum": ["OBJET_STRUCTURE_ABSENT", "RATTACHEMENT_AMBIGU", "ATTRIBUT_NON_REFERENCE", "VALEUR_AMBIGUE", "SOURCE_INSUFFISANTE", "AUTRE"]},
    "description": {"type": "string"},
    "object_type_suspected": {"type": ["string", "null"]},
    "source_anchor": {"type": ["string", "null"]},
    "page_or_plan": {"type": ["string", "null"]},
    "confidence_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
  },
  "additionalProperties": true
}
