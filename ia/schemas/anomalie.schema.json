{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIANE Anomalie de captation",
  "type": "object",
  "required": ["programme_id", "capture_id", "anomaly_id", "anomaly_type", "description"],
  "properties": {
    "programme_id": {"type": "string"},
    "capture_id": {"type": "string"},
    "source_id": {"type": ["string", "null"]},
    "anomaly_id": {"type": "string"},
    "anomaly_type": {"enum": ["OBJET_STRUCTURE_ABSENT", "INCOHERENCE_STRUCTURE", "RATTACHEMENT_AMBIGU", "ATTRIBUT_NON_CAPTABLE", "SOURCE_AMBIGUE", "AUTRE"]},
    "object_id": {"type": ["string", "null"]},
    "proposed_object_type": {"type": ["string", "null"]},
    "source_reference": {"type": ["string", "null"]},
    "description": {"type": "string"},
    "confidence_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
  },
  "additionalProperties": true
}