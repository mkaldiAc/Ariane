{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIANE Objet patrimonial ou candidat de capture",
  "type": "object",
  "required": ["programme_id", "structure_version", "object_id", "object_type"],
  "properties": {
    "programme_id": {"type": "string"},
    "capture_id": {"type": ["string", "null"]},
    "structure_version": {
      "type": "string",
      "description": "Pour un CANDIDAT_STRUCTURE, désigne la structure validée de référence par rapport à laquelle l'objet a été détecté absent ; cela ne signifie pas que l'objet appartient à cette structure."
    },
    "object_id": {"type": "string"},
    "object_type": {"type": "string"},
    "object_status": {
      "enum": ["PROPOSEE", "VALIDEE", "CANDIDAT_STRUCTURE", null]
    },
    "label": {"type": ["string", "null"]},
    "parent_object_id": {"type": ["string", "null"]},
    "source_id": {"type": ["string", "null"]},
    "candidate_anomaly_id": {"type": ["string", "null"]},
    "confidence_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
  },
  "additionalProperties": true
}
