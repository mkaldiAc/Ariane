{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIANE Métadonnées d'une CAPTURE stockée",
  "type": "object",
  "required": ["programme_id", "capture_id", "sequence", "mode", "ariane_version", "structure_version", "immutable", "files"],
  "properties": {
    "programme_id": {"type": "string", "minLength": 1},
    "capture_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["INITIALISATION_PROGRAMME", "CAPTATION_INCREMENTALE"]},
    "ariane_version": {"type": "string", "minLength": 1},
    "structure_version": {"type": ["string", "null"]},
    "immutable": {"const": true},
    "files": {
      "type": "object",
      "required": ["sources", "observations", "relations", "anomalies"],
      "properties": {
        "sources": {"type": "string"},
        "structure_proposee": {"type": ["string", "null"]},
        "objets_candidats": {"type": ["string", "null"]},
        "observations": {"type": "string"},
        "relations": {"type": "string"},
        "anomalies": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}