{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ariane.capture-request.schema.json",
  "type": "object",
  "required": ["mode", "programme_id", "capture_id"],
  "properties": {
    "mode": {"enum": ["INITIALISATION_PROGRAMME", "CAPTATION_INCREMENTALE"]},
    "programme_id": {"type": "string", "minLength": 1},
    "capture_id": {"type": "string", "minLength": 1},
    "structure_version": {"type": "string"},
    "documents": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "CAPTATION_INCREMENTALE"}}},
      "then": {"required": ["structure_version"]}
    }
  ],
  "additionalProperties": true
}
